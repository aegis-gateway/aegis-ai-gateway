# Provider API keys — at least one is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_ORG_ID=

# Server-side pepper for HMAC API-key hashing. The gateway refuses to start
# without one of at least 32 characters. Leave blank — each demo's run.sh
# generates a throwaway value via ../shared/ensure-pepper.sh.
AEGIS_KEY_PEPPER=
