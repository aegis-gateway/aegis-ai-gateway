# Copy to .env and fill in your values.
# mise auto-loads .env when entering the project directory.

# Provider API keys (required for proxying to real LLMs)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_ORG_ID=

# Database (uncomment to override Docker Compose defaults)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=aegis
# DB_PASSWORD=aegis-dev
# DB_NAME=aegis

# Redis (uncomment to override Docker Compose defaults)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Server-side pepper for HMAC-SHA256 API key hashing (required; min 32 chars).
# Left commented on purpose: mise loads this file after its [env] block, so an
# empty AEGIS_KEY_PEPPER= would override the local-development default in
# .mise.toml and stop the gateway from starting. Uncomment only with a real value.
# Generate with: openssl rand -hex 32
# AEGIS_KEY_PEPPER=
