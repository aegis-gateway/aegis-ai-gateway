# Production environment template for AEGIS AI Gateway.
# Copy to .env.production and fill in all values before deploying.
# Never commit this file with real values.

# ── Provider API Keys ─────────────────────────────────────────────────────────
# At least one is required. The gateway will only route to providers with keys set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_ORG_ID=

# ── Database ──────────────────────────────────────────────────────────────────
# Use a strong, randomly generated password.
DB_HOST=postgres
DB_PORT=5432
DB_USER=aegis
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_NAME=aegis

# DATABASE_URL is read by the keygen and migrate CLIs only. The gateway builds its
# own DSN from the DB_* vars above and hardcodes sslmode=disable, so setting this
# does NOT switch the gateway to TLS. Keep PostgreSQL on a trusted network.
# DATABASE_URL=postgres://aegis:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/aegis?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Gateway ───────────────────────────────────────────────────────────────────
GATEWAY_PORT=8080
METRICS_PORT=9090
LOG_LEVEL=info

# ── Open WebUI (if using bundled UI) ─────────────────────────────────────────
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=REPLACE_WITH_STRONG_SECRET

# ── OPA Policy ───────────────────────────────────────────────────────────────
OPA_POLICY_BUNDLE_PATH=./policies

# ── Production Notes ─────────────────────────────────────────────────────────
# 1. Rotate the demo API key immediately after first deploy (aegis-demo-quickstart)
# 2. Do NOT expose PostgreSQL or Redis ports publicly
# 3. Run behind TLS — see docs/DEPLOYMENT.md for nginx example
# 4. Set LOG_LEVEL=info (not debug) to avoid leaking request details in logs
